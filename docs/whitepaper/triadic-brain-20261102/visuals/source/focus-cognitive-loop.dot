digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.8", ranksep="0.8", splines=spline, overlap=false, outputorder=edgesfirst, fontname="DejaVu Sans", labelloc=t, fontsize=26, label="One governed cognitive loop — intended flow\n\nINTENDED FLOW · NOT IMPLEMENTED-EDGE EVIDENCE\nTeal: data | Amber: control | Purple: provenance\nAll nodes reference primary homes in the module index."];
node [shape=box, style="rounded,filled", fillcolor="#f0f7f7", color="#a2bcc0", penwidth=1.4, fontname="DejaVu Sans", fontsize=18, margin="0.18,0.15"];
edge [fontname="DejaVu Sans", fontsize=14, penwidth=1.8, arrowsize=0.8, style=dashed];
"human" [label="Human intent and visible\nresult\nF03"];
"ingress" [label="Sonya: preserve and bound\ninput\nF04"];
"plan" [label="Executive: finite plan and\nrole work\nF19, F47, F20"];
"candidate" [label="CoherenceLattice: fixed\ncandidate\nF07"];
"review" [label="Sophia: attributable findings\nF09"];
"orient" [label="Atlas: explain result and\ndissent\nF10"];
"stop" [label="Stop / redirect\nrecommendation\nF83"];
"custody" [label="Custody: minimized outcomes\nand unknowns\nF35"];
"tel" [label="TEL: navigable stage history\nF28"];
{rank=same; "human";"ingress";}
{rank=same; "plan";"stop";}
{rank=same; "candidate";}
{rank=same; "review";"custody";}
{rank=same; "orient";"tel";}
"human" -> "ingress" [color="#087f8c", fontcolor="#087f8c", label="task and context"];
"ingress" -> "plan" [color="#087f8c", fontcolor="#087f8c", label="attributable bounded\nrequest"];
"plan" -> "candidate" [color="#087f8c", fontcolor="#087f8c", label="admitted task evidence and\nrole outputs"];
"candidate" -> "review" [color="#087f8c", fontcolor="#087f8c", label="fixed candidate, evidence,\nresiduals"];
"review" -> "orient" [color="#087f8c", fontcolor="#087f8c", label="findings, limits and\ndissent"];
"orient" -> "human" [color="#087f8c", fontcolor="#087f8c", label="presentation; human\ndecision remains separate"];
"review" -> "plan" [color="#087f8c", fontcolor="#087f8c", label="findings for a separately\nauthorized revision"];
"plan" -> "stop" [color="#087f8c", fontcolor="#087f8c", label="risk, remaining budget and\ntask signals"];
"stop" -> "plan" [color="#9a5b06", fontcolor="#9a5b06", label="halt / redirect / continue\nrecommendation"];
"plan" -> "custody" [color="#7451a8", fontcolor="#7451a8", label="observed attempts and\noutcomes"];
"review" -> "custody" [color="#7451a8", fontcolor="#7451a8", label="observed review lifecycle\nand identity"];
"custody" -> "tel" [color="#7451a8", fontcolor="#7451a8", label="permitted supported events\nfor navigation"];
"tel" -> "orient" [color="#7451a8", fontcolor="#7451a8", label="ordered stage/evidence\nchronology"];
