digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.8", ranksep="0.8", splines=spline, overlap=false, outputorder=edgesfirst, fontname="DejaVu Sans", labelloc=t, fontsize=26, label="Authority stays with the deciding owner\n\nINTENDED FLOW · NOT IMPLEMENTED-EDGE EVIDENCE\nTeal: data | Amber: control | Purple: provenance\nAll nodes reference primary homes in the module index."];
node [shape=box, style="rounded,filled", fillcolor="#f0f7f7", color="#a2bcc0", penwidth=1.4, fontname="DejaVu Sans", fontsize=18, margin="0.18,0.15"];
edge [fontname="DejaVu Sans", fontsize=14, penwidth=1.8, arrowsize=0.8, style=dashed];
"human" [label="Human selection, stop or\nrevocation\nF03"];
"draft" [label="Source-faithful draft and\npreview\nF59"];
"adopt" [label="Authorized adoption: current\npolicy version\nF45"];
"business" [label="UCC advisory business\nfindings\nF22"];
"screen" [label="Non-authorizing admission\nscreen\nF29"];
"admit" [label="Actual admission / protective\nowner\nF23"];
"effect" [label="Each actual action / resource\n/ memory owner\nF45, F36, F13"];
"history" [label="Custody: original outcome\nplus correction\nF35"];
"recover" [label="Current session owner: resume\nor hold\nF62"];
{rank=same; "human";}
{rank=same; "draft";"adopt";"business";}
{rank=same; "screen";"admit";}
{rank=same; "effect";"recover";}
{rank=same; "history";}
"human" -> "draft" [color="#087f8c", fontcolor="#087f8c", label="source controls and\nrequested interpretation"];
"draft" -> "adopt" [color="#087f8c", fontcolor="#087f8c", label="proposed mapping and\npreview, not activation"];
"human" -> "adopt" [color="#9a5b06", fontcolor="#9a5b06", label="explicit adoption or\nchanged permission"];
"adopt" -> "business" [color="#9a5b06", fontcolor="#9a5b06", label="accepted advisory procedure\nprofile"];
"business" -> "human" [color="#087f8c", fontcolor="#087f8c", label="advisory finding\naccompanies actual reply"];
"adopt" -> "screen" [color="#9a5b06", fontcolor="#9a5b06", label="current consent / privacy /\ncontext conditions"];
"screen" -> "admit" [color="#087f8c", fontcolor="#087f8c", label="screen result; owner still\ndecides"];
"admit" -> "effect" [color="#9a5b06", fontcolor="#9a5b06", label="admit / hold / refuse\nwithin owned scope"];
"adopt" -> "effect" [color="#9a5b06", fontcolor="#9a5b06", label="current version; changed or\nrevoked permission"];
"effect" -> "history" [color="#7451a8", fontcolor="#7451a8", label="record actual outcome,\nversion and unknowns"];
"history" -> "recover" [color="#7451a8", fontcolor="#7451a8", label="checkpoint, owner version\nand outcome ledger"];
"adopt" -> "recover" [color="#9a5b06", fontcolor="#9a5b06", label="revalidate current context,\nscope and consent"];
"recover" -> "effect" [color="#9a5b06", fontcolor="#9a5b06", label="current owner resumes or\nholds; stale rejected"];
}
