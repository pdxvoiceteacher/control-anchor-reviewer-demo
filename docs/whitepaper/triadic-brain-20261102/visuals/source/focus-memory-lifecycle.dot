digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.4", nodesep="0.8", ranksep="0.8", splines=spline, overlap=false, outputorder=edgesfirst, fontname="DejaVu Sans", labelloc=t, fontsize=26, label="Memory has separate decisions — not one write arrow\n\nINTENDED FLOW · NOT IMPLEMENTED-EDGE EVIDENCE\nTeal: data | Amber: control | Purple: provenance\nAll nodes reference primary homes in the module index."];
node [shape=box, style="rounded,filled", fillcolor="#f0f7f7", color="#a2bcc0", penwidth=1.4, fontname="DejaVu Sans", fontsize=18, margin="0.18,0.15"];
edge [fontname="DejaVu Sans", fontsize=14, penwidth=1.8, arrowsize=0.8, style=dashed];
"material" [label="Task observations and memory\ncandidates\nF48"];
"custody" [label="Required minimized custody\nF35"];
"posture" [label="Memory-intent review posture\nF85"];
"owner" [label="Authenticated retention /\ndisposition owner\nF13"];
"index" [label="Eligible lineage query and\ndependencies\nF68, F66"];
"retrieve" [label="Eligible prior candidate\npacket\nF84"];
"use" [label="Current-use owner + scope-\nlimited posture\nF81"];
"consumer" [label="Atlas / exact authorized\nanswer consumer\nF10, F81"];
"influence" [label="Post-use influence review\nF82"];
"lifecycle" [label="Dependency-aware lifecycle\nproposal\nF69"];
{rank=same; "material";"custody";}
{rank=same; "posture";"owner";}
{rank=same; "index";"lifecycle";}
{rank=same; "retrieve";"use";}
{rank=same; "consumer";"influence";}
"material" -> "custody" [color="#7451a8", fontcolor="#7451a8", label="minimized observed task\nevents, not every payload"];
"material" -> "posture" [color="#087f8c", fontcolor="#087f8c", label="proposed memory intent and\nreview evidence"];
"posture" -> "owner" [color="#087f8c", fontcolor="#087f8c", label="candidate posture; separate\ntransaction decision"];
"owner" -> "index" [color="#087f8c", fontcolor="#087f8c", label="only eligible retained\nlineage and query scope"];
"index" -> "retrieve" [color="#087f8c", fontcolor="#087f8c", label="eligible provenance /\ncandidates / reasons"];
"retrieve" -> "use" [color="#087f8c", fontcolor="#087f8c", label="candidate packet and\nproposed-use trace"];
"use" -> "consumer" [color="#9a5b06", fontcolor="#9a5b06", label="only currently authorized\npurpose-bound use"];
"consumer" -> "influence" [color="#7451a8", fontcolor="#7451a8", label="returned identity and\ndeclared use evidence"];
"influence" -> "posture" [color="#087f8c", fontcolor="#087f8c", label="findings for separately\nauthorized correction"];
"index" -> "lifecycle" [color="#087f8c", fontcolor="#087f8c", label="retained graph,\ndependencies and\nrecommendation"];
"lifecycle" -> "owner" [color="#087f8c", fontcolor="#087f8c", label="lifecycle plan; owner\ndecides actual effect"];
"owner" -> "use" [color="#9a5b06", fontcolor="#9a5b06", label="expiry / revocation and\nchanged current permission"];
"owner" -> "custody" [color="#7451a8", fontcolor="#7451a8", label="record permitted effects\nand unknowns"];
}
