{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:triadic-brain:paper-claims:v1",
  "title": "Explanatory manuscript claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "as_of",
    "publication_status",
    "evidence_class_definitions",
    "claim_count",
    "claims"
  ],
  "properties": {
    "schema_id": {
      "const": "triadic-brain-paper-claims.v1"
    },
    "version": {
      "const": "release-1.2-candidate"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "publication_status": {
      "const": "LOCAL_SUCCESSOR_NOT_PUBLISHED"
    },
    "evidence_class_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "S",
        "C",
        "T",
        "R",
        "D",
        "P",
        "H",
        "U"
      ],
      "properties": {
        "S": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "T": {
          "type": "string",
          "minLength": 1
        },
        "R": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        },
        "P": {
          "type": "string",
          "minLength": 1
        },
        "H": {
          "type": "string",
          "minLength": 1
        },
        "U": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_count": {
      "type": "integer",
      "minimum": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "evidence_classes",
          "scope",
          "source_groups",
          "manuscript_section",
          "limitations",
          "depends_on",
          "product_executed_by_this_study"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "S",
                "C",
                "T",
                "R",
                "D",
                "P",
                "H",
                "U"
              ]
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^I[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "manuscript_section": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "product_executed_by_this_study": {
            "const": false
          }
        }
      }
    }
  },
  "$comment": "Syntactic validation only. Count equality, unique IDs, acyclic dependencies, source references and manuscript sections require procedural validation."
}
