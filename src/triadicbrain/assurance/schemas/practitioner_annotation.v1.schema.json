{
  "$id": "https://ultraverbaluxmentis.org/schemas/aep01/practitioner-annotation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "annotation_type": {
      "enum": [
        "NOTE",
        "MAPPING_CHALLENGE",
        "EVIDENCE_REQUEST",
        "PROCEDURE_RECORD",
        "FINDING_DRAFT",
        "EXTERNAL_CONCLUSION_REFERENCE"
      ]
    },
    "content": {
      "maxLength": 20000,
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "engagement_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "items": {
        "properties": {
          "object_id": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nonauthority": {
      "type": "string"
    },
    "practitioner_actor_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "uvlm.triadicbrain.aep01.practitioner_annotation.v1"
    },
    "signature_posture": {
      "enum": [
        "UNSIGNED",
        "EXTERNAL_SIGNATURE"
      ]
    },
    "source_evidence_mutated": {
      "const": false
    },
    "supersedes_annotation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "annotation_id",
    "practitioner_actor_id",
    "engagement_id",
    "annotation_type",
    "evidence_refs",
    "content",
    "created_at_utc",
    "source_evidence_mutated",
    "signature_posture",
    "nonauthority"
  ],
  "title": "AEP01 Practitioner Annotation",
  "type": "object"
}
