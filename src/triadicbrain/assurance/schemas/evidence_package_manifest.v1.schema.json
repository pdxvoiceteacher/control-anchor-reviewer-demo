{
  "$id": "https://ultraverbaluxmentis.org/schemas/aep01/evidence-package-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "NONE"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "effects": {
      "type": "object"
    },
    "excluded_sensitive_members": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "finalized": {
      "type": "boolean"
    },
    "finalized_at_utc": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "confidentiality": {
            "enum": [
              "PUBLIC_SYNTHETIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "object_type": {
            "type": "string"
          },
          "path": {
            "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256",
          "object_type",
          "confidentiality",
          "required"
        ],
        "type": "object"
      },
      "minItems": 18,
      "type": "array"
    },
    "nonauthority": {
      "minLength": 20,
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "parent_transaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "predecessor_review_dependency": {
      "properties": {
        "candidate_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "HOLD",
            "SUPERSEDED"
          ]
        }
      },
      "required": [
        "candidate_commit",
        "status"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "uvlm.triadicbrain.aep01.evidence_package_manifest.v1"
    },
    "segregation_posture": {
      "enum": [
        "LOGICAL_ROLE_SEPARATION",
        "SUBPROCESS_SAME_OS_PRINCIPAL",
        "OS_PRINCIPAL_SEPARATED",
        "REMOTE_EVIDENCE_SERVICE"
      ]
    },
    "signing_posture": {
      "enum": [
        "HASH_CHAIN_ONLY",
        "HMAC_TEST_ONLY",
        "ED25519_EXTERNAL_SIGNER",
        "SCITT_EXTERNAL_RECEIPT"
      ]
    },
    "state": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "package_id",
    "transaction_id",
    "state",
    "finalized",
    "segregation_posture",
    "signing_posture",
    "predecessor_review_dependency",
    "members",
    "excluded_sensitive_members",
    "package_root_sha256",
    "effects",
    "authority_effect",
    "nonauthority"
  ],
  "title": "AEP01 Evidence Package Manifest",
  "type": "object"
}
