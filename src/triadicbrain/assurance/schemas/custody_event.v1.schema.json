{
  "$id": "https://ultraverbaluxmentis.org/schemas/aep01/custody-event.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_class": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "ledger_id": {
      "type": "string"
    },
    "logical_time": {
      "type": "string"
    },
    "observed_time_utc": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string"
    },
    "output_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "plane": {
      "type": "string"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD",
        "NOT_EXECUTED",
        "ERROR",
        "REFUSED"
      ]
    },
    "schema_id": {
      "const": "uvlm.triadicbrain.aep01.custody_event.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "side_effects": {
      "type": "object"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_type": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "ledger_id",
    "transaction_id",
    "sequence",
    "logical_time",
    "observed_time_utc",
    "actor_id",
    "actor_class",
    "plane",
    "operation",
    "subject_type",
    "subject_id",
    "input_digests",
    "output_digests",
    "previous_event_sha256",
    "event_sha256",
    "result",
    "reason_codes",
    "side_effects",
    "authority_effect"
  ],
  "title": "AEP01 Custody Event",
  "type": "object"
}
