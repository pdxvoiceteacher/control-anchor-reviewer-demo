{
  "$id": "https://ultraverbaluxmentis.org/schemas/aep01/control-execution-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "canonical_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "control_id": {
      "pattern": "^AI-[A-Z]{3}-[0-9]{2}$",
      "type": "string"
    },
    "control_type": {
      "enum": [
        "preventive",
        "detective",
        "corrective",
        "monitoring"
      ]
    },
    "control_version": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "properties": {
          "object_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "exceptions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expected_condition": {},
    "frequency": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_judgment_required": {
      "type": "boolean"
    },
    "method": {
      "enum": [
        "automated",
        "manual",
        "hybrid"
      ]
    },
    "observed_condition": {},
    "observed_time_utc": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "period_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plane": {
      "type": "string"
    },
    "procedure_id": {
      "type": "string"
    },
    "procedure_version": {
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD",
        "NOT_EXECUTED",
        "ERROR"
      ]
    },
    "schema_id": {
      "const": "uvlm.triadicbrain.aep01.control_execution_result.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "side_effects": {
      "type": "object"
    },
    "superseded": {
      "type": "boolean"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "execution_id",
    "transaction_id",
    "control_id",
    "control_version",
    "procedure_id",
    "procedure_version",
    "sequence",
    "actor_id",
    "plane",
    "control_type",
    "method",
    "expected_condition",
    "observed_condition",
    "result",
    "reason_codes",
    "evidence_refs",
    "exceptions",
    "human_judgment_required",
    "superseded",
    "side_effects",
    "authority_effect",
    "canonical_result_sha256"
  ],
  "title": "AEP01 Control Execution Result",
  "type": "object"
}
